---
import Base from '../layouts/Base.astro';
import CurrentlyLearning from '../components/CurrentlyLearning.astro';
import BookStack from '../components/BookStack.astro';

const topics = [
  "MLflow",
  "Probability Distributions",
  "Exploratory Data Analysis",
  "Linear Predictors",
  "Correlation",
  "Regression",
  "Gradient Descent",
];

const currentlyReading = [
  {
    title: "Misery",
    author: "Stephen King",
    cover: "/images/covers/misery.jpg",
    link: "https://en.wikipedia.org/wiki/Misery_(novel)",
  },

  {
    title: "Angels and Demons",
    author: "Dan Brown",
    cover: "/images/covers/angelsAndDemons.jpg",
    link: "https://en.wikipedia.org/wiki/Angels_%26_Demons",
  },
];

const recentlyRead = [
  {
    title: "Dark Places",
    author: "Gillian Flynn",
    cover: "/images/covers/darkPlacesCover.jpg",
    link: "https://en.wikipedia.org/wiki/Dark_Places_(Flynn_novel)",
  },
  {
    title: "'Salem's Lot'",
    author: "Stephen King",
    cover: "/images/covers/salemsLot.jpg",
    link: "https://en.wikipedia.org/wiki/%27Salem%27s_Lot",
  },
  {
    title: "The Shining",
    author: "Stephen King",
    cover: "/images/covers/theShining.jpg",
    link: "https://en.wikipedia.org/wiki/The_Shining_(novel)",
  },
  {
    title: "Pet Sematary",
    author: "Stephen King",
    cover: "/images/covers/petSematary.jpg",
    link: "https://en.wikipedia.org/wiki/Pet_Sematary",
  },
  {
    title: "Gone Girl",
    author: "Gillian Flynn",
    cover: "/images/covers/goneGirl.jpg",
    link: "https://en.wikipedia.org/wiki/Gone_Girl_(novel)",
  },
  {
    title: "And Then There Were None",
    author: "Agatha Christie",
    cover: "/images/covers/andThenThereWereNone.jpg",
    link: "https://en.wikipedia.org/wiki/And_Then_There_Were_None",
  },
];
---
<Base title="About - Vibhav Misra">
  <section class="mx-auto max-w-6xl px-4 py-12 prose prose-invert">
    <h1>About</h1>

    <p>
      Hi, I’m Vibhav Misra, a recent M.S. Data Science graduate from Pace University in New York City, honored Magna Cum Laude. I’m interested in building practical data systems that turn complex, messy information into clear insights, useful tools, and better decisions.
    </p>

    <p>
      My interest in data started in 2020 while exploring COVID-19 trends, and over time it grew into a broader focus on machine learning, analytics, visualization, and applied AI. Before coming to NYC, I completed my bachelor’s degree in Computer Science and Engineering with a specialization in Artificial Intelligence and Machine Learning.
    </p>

    <p>
      I like working across the full data pipeline: data collection, cleaning, exploratory analysis, feature engineering, modeling, evaluation, and deployment. Some of my recent projects include a NYC 311 service quality dashboard, a global economic stress early-warning system, a resume-grounded AI chatbot, a memory manager for AI assistants, and real-time transit tools using NYC subway data.
    </p>

    <p>
      Beyond models and dashboards, I care about communication. I see data science as a way to explain, predict, and engage - whether through a well-designed visualization, an interactive app, or a clear technical write-up.
    </p>

    <p>
      I’m currently seeking full-time opportunities in data analytics, business intelligence, data science, machine learning, business analysis, or operations analytics.
    </p>

    <p> For a full overview of my experience,
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-emerald-400 hover:underline"
      >
        view my resume
      </a>
    </p>
  </section>

  <div class="mx-auto max-w-3xl px-4">
    <CurrentlyLearning items={topics} intervalMs={2200} title="Currently learning" />
  </div>

  <div class="mx-auto max-w-3xl px-4 mt-8">
    <BookStack currentBooks={currentlyReading} readBooks={recentlyRead} title="My Book Stack" />
  </div>

</Base>